# Google OAuth Client ID
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add http://localhost:5173 to Authorized JavaScript origins
# 5. Copy the Client ID below
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google AdSense Publisher ID
# 1. Go to https://adsense.google.com/
# 2. Sign up and get approved (takes 1-3 days)
# 3. Copy your Publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# 4. Replace each data-ad-slot in index.html with your real ad unit slot IDs
# 5. Also update the slot props in DashboardPage.tsx and TaskList.tsx
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
